# Reference settings only. Use the PostgreSQL login chosen by the owner.
PGHOST=localhost
PGPORT=5432
PGDATABASE=void2-0e2ee
PGUSER=postgres
PGPASSWORD=replace-with-a-strong-local-password
PGSSLMODE=prefer
VOID_HTTP_ADDR=127.0.0.1:8080
VOID_WORKER_ID=0
VOID_SNOWFLAKE_EPOCH=2026-01-01T00:00:00Z
VOID_CHALLENGE_TTL=2m
VOID_MAX_CHALLENGES=4096
VOID_REQUEST_TIMEOUT=5s
VOID_SHUTDOWN_TIMEOUT=10s
VOID_RATE_PER_MINUTE=30
VOID_RATE_BURST=10
VOID_MAX_RATE_CLIENTS=4096
VOID_MAX_CONCURRENT_REQUESTS=64
VOID_DATABASE_MAX_CONNS=8
VOID_WS_AUTH_TIMEOUT=10s
VOID_WS_MAX_CONNECTIONS=256
VOID_WS_QUEUE_SIZE=16
VOID_WS_MAX_PAYLOAD_BYTES=16384
# Enable only after reviewing/applying migrations/001_messaging.sql and
# migrations/002_sessions.sql. Existing .env is never changed automatically.
# Durable messaging disables the earlier unauthorised-by-conversation /ws relay.
VOID_MESSAGING_ENABLED=false
VOID_API_AUDIENCE=https://api.voidchats.xyz/dm9pZG5vdGhpbmduZXNz
