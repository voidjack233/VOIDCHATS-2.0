# Copy to .env; .env is ignored. Never put these credentials in the mobile app.
# Generate locally if absent. Keep an existing PGPASSWORD when already configured.
PGPASSWORD=replace-with-a-locally-generated-password
PGHOST=127.0.0.1
# Avoid the common native PostgreSQL port; Podman publishes only on loopback.
PGPORT=15432
PGUSER=void_dev
PGDATABASE=void_dev
PGSSLMODE=disable
VOID_ENV=development
VOID_HTTP_HOST=127.0.0.1
VOID_HTTP_PORT=8080
# Optional full override, e.g. 0.0.0.0:8080 for trusted LAN development.
# VOID_HTTP_ADDR=0.0.0.0:8080
VOID_DIAGNOSTIC_ADDR=127.0.0.1:8091
