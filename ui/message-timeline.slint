import { Theme } from "theme.slint";
import { Action, PaneScroll, Clickable, NavigationInput } from "controls.slint";
import { MessageBubble, StoredMessage } from "message-bubble.slint";

export component MessageTimeline inherits Rectangle {
    in property <[StoredMessage]> stored-messages;
    in property <length> pane-width;
    in property <length> thread-gutter;
    in property <length> chat-gutter;
    in property <bool> timeline-has-older;
    in property <bool> timeline-has-newer;
    in property <bool> timeline-loading;
    in property <int> timeline-revision;
    in-out property <bool> timeline-following: true;
    in-out property <string> timeline-anchor-key;
    in-out property <length> timeline-anchor-offset;
    in-out property <length> timeline-viewport-y <=> timeline.content-y;
    in-out property <bool> timeline-reflowing <=> timeline.reflowing;
    callback remember-message-position(string, length);
    in property <string> timeline-today;
    in property <string> timeline-yesterday;
    in property <bool> conversation-loading;
    in property <bool> conversation-peer-deleted;
    in property <bool> messaging-ready;
    in property <bool> send-busy;
    in property <bool> remote-enabled;
    in property <bool> action-busy;
    // NOTE2EE's comfortable-density floor, scaled up for taller viewports.
    in property <length> older-prefetch-distance: 640px;
    callback message-action(StoredMessage, string, length, length);
    callback toggle-reaction(string, string, string);
    callback page-timeline(bool);
    callback jump-to-present();
    callback resend-message(string);
    callback open-quote(string);
    callback clear-timestamp-tip();
    callback timestamp-hovered(int, string, length, length);
    callback timestamp-left(int);

    min-height: 72px;
    vertical-stretch: 1;
    // The scroll view passes through wheel input when it can't move further.
    TouchArea {
        scroll-event(event) => {
            let older = event.delta-y > 0px && timeline.content-y >= 0px && root.timeline-has-older;
            let newer = event.delta-y < 0px && timeline.content-y <= timeline.end-offset
                && root.timeline-has-newer;
            if (older || newer) && !root.conversation-loading {
                root.timeline-following = false;
                timeline.scroll-revision += 1;
                timeline.page-direction = older ? -1 : 1;
                return accept;
            }
            return reject;
        }
    }
    timeline := PaneScroll {
        width: parent.width;
        height: parent.height;
        private property <length> end-offset: min(0px, self.visible-height - self.content-height);
        private property <length> tracked-y;
        private property <int> scroll-revision;
        private property <int> captured-revision: -1;
        private property <int> page-direction;
        private property <bool> capture-pending;
        private property <bool> awaiting-page;
        private property <bool> reflowing;
        private property <int> model-revision: root.timeline-revision;
        private property <bool> following: root.timeline-following;
        private property <bool> opening: root.conversation-loading;
        private property <length> older-threshold: max(root.older-prefetch-distance, 2 * self.visible-height);
        private property <{ revision: int, width: length, height: length, content: length }> geometry:
            { revision: self.model-revision, width: self.visible-width,
                height: self.visible-height, content: self.content-height };
        private property <{ revision: int, width: length, height: length, content: length }> settled-geometry;

        function place-content(offset: length) {
            let target = clamp(offset, self.end-offset, 0px);
            // A programmatic correction must also replace the input baseline.
            self.tracked-y = target;
            if abs(target - self.content-y) > 0.25px {
                self.content-y = target;
            }
        }

        function sync-viewport() {
            self.place-content(self.following ? self.end-offset : self.content-y);
        }

        function user-scrolled(explicit-input: bool) {
            if self.content-y == self.tracked-y { return; }
            let delta = self.content-y - self.tracked-y;
            let older = delta > 0px;
            self.tracked-y = self.content-y;
            // Model reconciliation, resizing and anchor placement can clamp the
            // viewport too. Only real ScrollView input may create demand then.
            if self.opening || (!explicit-input && (self.reflowing || self.geometry != self.settled-geometry)) { return; }
            // Retain movement immediately, even if the worker commits before
            // reactive row capture runs. The next capture picks the visible key.
            if !root.timeline-following && root.timeline-anchor-key != "" {
                root.timeline-anchor-offset += delta;
            }
            root.timeline-following = !root.timeline-has-newer
                && self.content-y <= self.end-offset + 8px;
            if root.timeline-following {
                root.timeline-anchor-key = "";
                root.timeline-anchor-offset = 0px;
            } else {
                self.scroll-revision += 1;
            }
            // Each untracked position delta is fresh scroll intent, including
            // scrollbar input and movement received while a page is loading.
            self.page-direction = older ? -1 : 1;
        }

        init => { self.sync-viewport(); }
        changed following => {
            if self.following {
                self.page-direction = 0;
                self.capture-pending = false;
            }
            self.sync-viewport();
        }
        changed opening => {
            if self.opening {
                self.page-direction = 0;
                self.capture-pending = false;
                self.awaiting-page = false;
            }
        }
        changed model-revision => {
            self.reflowing = true;
            self.sync-viewport();
        }
        changed end-offset => { self.sync-viewport(); }
        changed geometry => {
            self.reflowing = true;
            self.sync-viewport();
            self.settled-geometry = self.geometry;
            self.capture-pending = false;
        }
        // Animated wheel frames and scrollbar moves refresh the reading anchor.
        changed content-y => {
            root.clear-timestamp-tip();
            self.user-scrolled(false);
        }
        scrolled => {
            self.user-scrolled(true);
        }

        Timer {
            interval: 8ms;
            running: !root.conversation-loading && (timeline.awaiting-page
                || timeline.reflowing || timeline.page-direction != 0 || timeline.geometry != timeline.settled-geometry);
            triggered => {
                if root.timeline-loading { return; }
                // Let geometry change handlers restore the anchor before consuming
                // retained input. Proximity alone cannot authorize another page.
                if timeline.geometry != timeline.settled-geometry { return; }
                if timeline.reflowing {
                    // Geometry notifications and anchor corrections can arrive
                    // in different orders. Finish one settled turn before an
                    // implicit position change is interpreted as fresh input.
                    timeline.tracked-y = timeline.content-y;
                    timeline.reflowing = false;
                    return;
                }
                timeline.awaiting-page = false;
                let older = timeline.page-direction < 0;
                let eligible = older
                    ? root.timeline-has-older && timeline.content-y >= -timeline.older-threshold
                    : root.timeline-has-newer && timeline.content-y <= timeline.end-offset + 96px;
                if timeline.page-direction == 0 || root.timeline-following || !eligible {
                    timeline.page-direction = 0;
                    timeline.capture-pending = false;
                    return;
                }
                if !timeline.capture-pending || timeline.captured-revision != timeline.scroll-revision {
                    // Capture against settled, current geometry BEFORE the worker
                    // can replace/trim the window. Retry the capture pulse if rows
                    // materialized after the last one; never dispatch without ACK.
                    timeline.scroll-revision += 1;
                    timeline.capture-pending = true;
                    return;
                }
                timeline.page-direction = 0;
                timeline.capture-pending = false;
                // Keep the captured input baseline across the asynchronous page.
                timeline.tracked-y = timeline.content-y;
                timeline.content-y = timeline.tracked-y;
                // Keep this same timer alive through the asynchronous commit;
                // headless/native redraw scheduling must not lose restoration.
                timeline.awaiting-page = true;
                root.page-timeline(older);
            }
        }

        content-height: max(self.visible-height, history.min-height);

        history := VerticalLayout {
            alignment: root.stored-messages.length == 0 ? center : end;
            padding-left: root.thread-gutter;
            padding-right: root.thread-gutter;
            padding-top: root.chat-gutter;
            padding-bottom: root.chat-gutter;
            spacing: 6px;
            if root.stored-messages.length == 0: Text {
                text: "No saved messages";
                color: Theme.secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }
            for message[index] in root.stored-messages: row := VerticalLayout {
                alignment: start;
                spacing: 4px;
                private property <length> bubble-top: self.y + bubble-row.y;
                // Cache content coordinates only when layout changes. Scrolling
                // does not change these values or update the Rust message model.
                private property <{ key: string, y: length, tracking: bool }> position:
                    { key: message.key, y: self.bubble-top, tracking: !root.timeline-following };
                changed position => {
                    if self.position.tracking {
                        root.remember-message-position(self.position.key, self.position.y);
                    }
                }
                // Retain every row's layout/anchor geometry, but avoid rendering
                // distant bubble subtrees. Overscan prevents edge pop-in. Keyboard
                // navigation keeps all actions available in their original order.
                private property <bool> near-viewport: self.y + self.height >= -timeline.content-y - timeline.visible-height / 2
                    && self.y <= -timeline.content-y + 1.5 * timeline.visible-height;
                private property <int> user-scroll: timeline.scroll-revision;
                private property <bool> anchored: message.key != ""
                    && message.key == root.timeline-anchor-key && !root.timeline-following
                    && timeline.geometry == timeline.settled-geometry;
                private property <{ y: length, revision: int }> anchor-placement: self.anchored
                    ? { y: clamp(root.timeline-anchor-offset - self.bubble-top, timeline.end-offset, 0px),
                        revision: root.timeline-revision }
                    : { y: 0px, revision: 0 };

                init => {
                    if !root.timeline-following {
                        root.remember-message-position(message.key, self.bubble-top);
                    }
                    if self.anchored {
                        timeline.place-content(self.anchor-placement.y);
                    }
                }
                changed anchor-placement => {
                    if self.anchored {
                        timeline.place-content(self.anchor-placement.y);
                    }
                }
                changed user-scroll => {
                    // Keep the first on-screen message, including partial visibility.
                    // Store the bubble position so inserting a date marker doesn't move it.
                    let viewport-top = -timeline.content-y;
                    if !root.timeline-following && message.key != ""
                        && !timeline.reflowing && timeline.geometry == timeline.settled-geometry
                        && (index == 0 || self.y <= viewport-top + history.spacing)
                        && self.y + self.height > viewport-top {
                        root.timeline-anchor-key = message.key;
                        root.timeline-anchor-offset = self.bubble-top - viewport-top;
                        timeline.captured-revision = timeline.scroll-revision;
                    }
                }
                if message.day != "": HorizontalLayout {
                    spacing: 10px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Rectangle {
                        horizontal-stretch: 1;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                    Text {
                        text: message.day == root.timeline-today ? "Today"
                            : message.day == root.timeline-yesterday ? "Yesterday" : message.day;
                        color: Theme.secondary;
                        font-size: 11px;
                        horizontal-stretch: 0;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                }
                if message.quote != "" && !message.deleted: HorizontalLayout {
                    alignment: message.outgoing ? end : start;
                    Clickable {
                        width: min(260px, root.pane-width - 2 * root.thread-gutter);
                        height: 46px; background: Theme.surface; border-radius: 8px;
                        enabled: message.quote-target != "";
                        label: "Jump to quoted message: " + message.quote;
                        clicked => { root.open-quote(message.quote-target); }
                        VerticalLayout {
                            padding: 7px; spacing: 2px;
                            Text { text: message.quote-author; color: Theme.accent; font-size: 11px; overflow: elide; }
                            Text { text: message.quote; color: Theme.secondary; font-size: 12px; overflow: elide; }
                        }
                    }
                }
                bubble-row := HorizontalLayout {
                    alignment: message.outgoing ? end : start;
                    MessageBubble {
                        // Keep the saved anchor active while restoring it from
                        // outside the viewport, as well as keyboard-focused rows.
                        visible: row.near-viewport || message.key == root.timeline-anchor-key
                            || NavigationInput.keyboard || self.action-focused;
                        message: message;
                        remote-enabled: root.remote-enabled && !root.conversation-peer-deleted;
                        actions-enabled: !root.conversation-loading && !root.action-busy;
                        message-action(mode, x, y) => { root.message-action(message, mode, x, y); }
                        row-width: root.pane-width - 2 * root.thread-gutter;
                        width-limit: min(440px, (root.pane-width - 2 * root.thread-gutter) * 0.86);
                        show-retry: !message.deleted && !root.conversation-peer-deleted && message.retry-event != "";
                        retry-enabled: root.messaging-ready && !root.send-busy;
                        retry => { root.resend-message(message.retry-event); }
                        timestamp-hovered(label, x, y) => {
                            root.timestamp-hovered(index, label, x, y);
                        }
                        timestamp-left => {
                            root.timestamp-left(index);
                        }
                    }
                }
                if !message.deleted && message.reactions.length > 0: HorizontalLayout {
                    alignment: message.outgoing ? end : start;
                    GridLayout {
                        horizontal-stretch: 0; spacing: 4px;
                        for reaction[index] in message.reactions: Clickable {
                            row: floor(index / 3); col: mod(index, 3);
                            width: clamp(reaction-label.preferred-width + 18px, 44px, 74px); height: 26px; border-radius: 13px;
                            background: reaction.mine ? Theme.selected : Theme.surface;
                            border-width: 1px; border-color: reaction.mine ? Theme.accent : Theme.divider;
                            enabled: root.remote-enabled && !root.conversation-peer-deleted && !root.action-busy;
                            label: "Toggle reaction " + reaction.emoji;
                            clicked => { root.toggle-reaction(message.author-id, message.event-id, reaction.emoji); }
                            accessible-label: reaction.emoji + " " + reaction.count + (reaction.mine ? " including you" : "");
                            reaction-label := Text { text: reaction.emoji + " " + reaction.count; color: Theme.secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
    if root.timeline-has-newer || timeline.content-y > timeline.end-offset + 48px: Action {
        label: "Jump to Present";
        height: 36px;
        width: self.min-width;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 12px;
        enabled: !root.timeline-loading && !root.conversation-loading;
        clicked => { root.jump-to-present(); }
    }
}
