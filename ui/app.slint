import { CheckBox, LineEdit, ScrollView, Spinner, TextEdit } from "std-widgets.slint";

export struct StoredConversation { id: string, title: string, preview: string, activity: string, unread: bool }
export struct StoredContact { title: string, void-id: string }
export struct StoredMessage { body: string, day: string, time: string, exact-time: string, outgoing: bool, status: string, retry-event: string }

global Theme {
    out property <color> background: #0c1118;
    out property <color> surface: #151c25;
    out property <color> elevated: #1d2732;
    out property <color> primary: #f4f6f8;
    out property <color> secondary: #b0bac5;
    out property <color> accent: #95afe9;
    out property <color> sidebar: #101720;
    out property <color> divider: #26313d;
    out property <color> selected: #263448;
    out property <color> outgoing: #344969;
    out property <color> error: #ffb4a9;
}

component Clickable inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected;
    out property <bool> hovered: hit-area.has-hover;
    out property <bool> pressed: hit-area.pressed;
    out property <bool> keyboard-focused: key-focus.has-focus && !root.pointer-focus;
    private property <bool> pointer-focus;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: key-focus;
    border-radius: 10px;
    border-width: root.keyboard-focused ? 2px : 0px;
    border-color: Theme.accent;
    background: root.pressed ? Theme.outgoing : root.selected ? Theme.selected : root.hovered ? Theme.elevated : transparent;

    hit-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            key-focus.focus();
            root.pointer-focus = true;
            root.clicked();
        }
    }
    key-focus := FocusScope {
        width: 0;
        enabled: root.enabled;
        focus-gained(reason) => {
            if reason != FocusReason.window-activation {
                root.pointer-focus = reason == FocusReason.pointer-click;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.pointer-focus = false;
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component Action inherits Clickable {
    in property <bool> primary;
    in property <bool> destructive;
    height: 44px;
    min-width: action-text.preferred-width + 28px;
    horizontal-stretch: 0;
    private property <bool> filled: root.primary && !root.pressed && !root.hovered && !root.keyboard-focused;
    background: !root.enabled ? Theme.elevated
        : root.filled ? Theme.accent
        : root.pressed ? Theme.outgoing : root.selected || root.hovered ? Theme.selected : Theme.elevated;

    action-text := Text {
        text: root.label;
        color: !root.enabled ? Theme.secondary
            : root.destructive ? Theme.error
            : root.filled ? Theme.background : Theme.primary;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component PaneScroll inherits ScrollView {
    min-height: 0px;
    horizontal-scrollbar-policy: always-off;
    content-width: self.visible-width;
}

component WrappingText inherits Text {
    min-width: 0px;
    wrap: word-wrap;
}

enum NavIcon { chats, requests, contacts, settings }

component NavItem inherits Clickable {
    in property <NavIcon> icon;
    in property <float> label-opacity;
    in property <bool> unread;
    accessible-label: root.label + (root.unread ? ", unread messages" : "");
    height: 44px;
    clip: true;

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: root.icon == NavIcon.chats ? @image-url("icons/chats.svg")
            : root.icon == NavIcon.requests ? @image-url("icons/requests.svg")
            : root.icon == NavIcon.contacts ? @image-url("icons/contacts.svg")
            : @image-url("icons/settings.svg");
        colorize: root.selected ? Theme.accent : Theme.secondary;
        accessible-role: none;
    }

    if root.selected: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Theme.accent;
    }
    if root.unread: Rectangle {
        x: 29px;
        y: 8px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
    }

    Text {
        x: 44px;
        width: self.preferred-width;
        opacity: root.label-opacity;
        text: root.label;
        color: root.selected ? Theme.primary : Theme.secondary;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: clip;
        accessible-role: none;
    }
}

component SettingDetail inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> description;
    min-height: content.min-height;
    preferred-height: content.min-height;
    vertical-stretch: 0;
    background: Theme.elevated;
    border-radius: 12px;

    content := VerticalLayout {
        alignment: start;
        padding: 16px;
        spacing: 8px;
        Text { text: root.label; color: Theme.primary; font-size: 14px; font-weight: 600; }
        WrappingText { text: root.value; color: Theme.accent; font-size: 14px; }
        if root.description != "": WrappingText { text: root.description; color: Theme.secondary; font-size: 13px; }
    }
}

component AccountRemovalPage inherits Rectangle {
    in property <bool> permanent;
    in property <bool> busy;
    in property <string> status;
    in property <string> error;
    in property <string> phrase;
    in property <bool> can-confirm;
    in property <bool> can-go-back;
    callback edit-phrase(string);
    callback confirm();
    callback cancel();
    private property <length> gutter: max(24px, (root.width - 600px) / 2);

    PaneScroll {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            alignment: start;
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: clamp(root.height * 0.075, 24px, 48px);
            padding-bottom: 28px;
            spacing: 14px;
            Text {
                text: root.permanent ? "Delete account permanently" : "Remove from this device";
                color: Theme.primary;
                font-size: 30px;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.busy: HorizontalLayout {
                spacing: 12px;
                Spinner { width: 20px; height: 20px; }
                WrappingText { text: root.status; color: Theme.secondary; }
            }
            if root.error != "": WrappingText { text: root.error; color: Theme.error; }
            if !root.busy && root.error == "": VerticalLayout {
                alignment: start;
                spacing: 12px;
                Text {
                    text: root.permanent
                        ? "Your VOID-ID will be permanently deactivated. Other users will no longer be able to message you. This cannot be undone."
                        : "VOID will remove your saved credentials, encryption keys, conversations, and drafts from this Windows profile. This cannot be undone.";
                    color: Theme.primary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.permanent
                        ? "VOID removes undelivered messages and published encryption keys from its servers. Messages already delivered can remain on other devices."
                        : "Your VOID-ID and server account will remain registered. VOID will return to the welcome screen.";
                    color: Theme.secondary;
                    wrap: word-wrap;
                }
                if root.permanent: Text {
                    text: "VOID will remove this device’s credentials, Signal keys, and conversations after the server confirms deletion.";
                    color: Theme.secondary;
                    wrap: word-wrap;
                }
                Text { text: "Type DELETE to confirm"; color: Theme.primary; font-weight: 600; }
                LineEdit {
                    accessible-label: "Type DELETE to confirm";
                    height: 44px;
                    text: root.phrase;
                    edited(text) => { root.edit-phrase(text); }
                }
            }
            if !root.busy: HorizontalLayout {
                spacing: 8px;
                if root.error == "" || root.can-go-back: Action {
                    label: root.error == "" ? "Cancel" : "Back to setup";
                    clicked => { root.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Action {
                    label: root.error != "" ? (root.permanent ? "Retry deletion" : "Retry local removal")
                        : root.permanent ? "Delete account permanently" : "Remove from this device";
                    destructive: root.permanent;
                    enabled: root.error != "" || root.can-confirm;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

component UserAvatar inherits Rectangle {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: Theme.selected;
    accessible-role: none;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 19px;
        height: 19px;
        source: @image-url("icons/user.svg");
        colorize: Theme.accent;
    }
}

component StorageRow inherits Clickable {
    in property <string> detail;
    in property <string> activity;
    in property <bool> unread;
    accessible-label: root.label + ", " + root.detail + (root.activity != "" ? ", " + root.activity : "")
        + (root.unread ? ", unread messages" : "");
    min-height: 58px;
    vertical-stretch: 0;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 34px;
            UserAvatar { y: (parent.height - self.height) / 2; }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.label;
                    color: Theme.primary;
                    font-size: 14px;
                    font-weight: root.unread ? 700 : 600;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.activity != "": Text {
                    text: root.activity;
                    color: Theme.secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.detail;
                color: Theme.secondary;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.unread: Rectangle {
            width: 8px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
    }
}

component MessageBubble inherits Rectangle {
    in property <StoredMessage> message;
    in property <length> width-limit;
    in property <bool> show-retry;
    in property <bool> retry-enabled;
    callback retry();
    callback timestamp-hovered(string, length, length);
    callback timestamp-left();
    private property <length> inset: 9px;

    width: min(root.width-limit,
        max(body.preferred-width, footer.preferred-width, root.show-retry ? 84px : 0px) + 2 * root.inset);
    min-height: content.min-height;
    preferred-height: content.min-height;
    vertical-stretch: 0;
    background: root.message.outgoing ? Theme.outgoing : Theme.elevated;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.message.outgoing ? Theme.selected : Theme.divider;

    content := VerticalLayout {
        alignment: start;
        padding: root.inset;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        body := WrappingText {
            text: root.message.body;
            color: Theme.primary;
            font-size: 14px;
        }
        footer := HorizontalLayout {
            alignment: end;
            spacing: 4px;

            if root.message.time != "": Rectangle {
                width: clock.preferred-width;
                height: clock.preferred-height;

                clock := Text {
                    text: root.message.time;
                    accessible-label: root.message.exact-time;
                    color: Theme.secondary;
                    font-size: 11px;
                }

                TouchArea {
                    enabled: root.message.exact-time != "";
                    changed has-hover => {
                        if self.has-hover {
                            root.timestamp-hovered(root.message.exact-time,
                                self.absolute-position.x + self.width / 2, self.absolute-position.y);
                        } else {
                            root.timestamp-left();
                        }
                    }
                }
            }
            if root.message.status != "": WrappingText {
                text: root.message.status == "Sent to relay" ? "Relayed"
                : root.message.status == "Acceptance unconfirmed" ? "Unconfirmed"
                : root.message.status == "Send failed" ? "Failed" : root.message.status;
                accessible-label: root.message.status;
                color: Theme.secondary;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        if root.show-retry: HorizontalLayout {
            alignment: end;
            Action {
                label: "Resend";
                enabled: root.retry-enabled;
                clicked => { root.retry(); }
            }
        }
    }
}

component SetupStep inherits Rectangle {
    in property <string> label;
    in property <int> number;
    in property <int> current-page;
    private property <bool> current: root.number == root.current-page;
    private property <bool> completed: root.number < root.current-page;

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: root.current ? Theme.accent : Theme.elevated;
    accessible-role: text;
    accessible-label: root.label + (root.current ? ", current step" : root.completed ? ", completed" : "");
    animate background { duration: 160ms; easing: ease-out; }

    Text {
        text: root.completed ? "✓" : "" + root.number;
        color: root.current ? Theme.background : root.completed ? Theme.accent : Theme.secondary;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component SetupPage inherits Rectangle {
    in property <int> page;
    in property <int> current-page;
    in property <bool> show-steps;
    in property <bool> busy;
    in property <bool> can-retry;
    in property <bool> retry-storage;
    in property <string> status;
    in property <string> error;
    in property <string> action;
    in-out property <bool> security-acknowledged;
    in-out property <bool> terms-acknowledged;
    in property <length> gutter;
    in property <length> reading-width;
    in property <length> heading-size;
    in property <length> top-padding;
    callback submit();

    private property <bool> active: root.page == root.current-page;
    private property <bool> onboarding-step: root.show-steps && root.error == "";

    changed active => {
        if root.active { setup-content.content-y = 0px; }
    }

    setup-content := PaneScroll {
        width: parent.width;
        height: parent.height;
        enabled: root.active;
        VerticalLayout {
            padding-top: root.onboarding-step ? max(root.top-padding, setup-content.visible-height * 0.30)
                : root.top-padding;
            padding-bottom: 32px;
            padding-left: root.gutter;
            padding-right: root.gutter;

            Rectangle {
                horizontal-stretch: 1;
                max-width: root.reading-width;
                min-height: step-content.min-height;
                preferred-height: step-content.min-height;
                vertical-stretch: 0;

                step-content := VerticalLayout {
                    alignment: start;
                    spacing: root.onboarding-step ? 20px : 16px;

                    Text {
                        text: root.page == -1 ? "Opening VOID"
                            : root.page == 1 ? "Welcome to VOID"
                            : root.page == 2 ? "How VOID works"
                            : root.page == 3 ? "Security notice"
                            : root.page == 4 ? "Terms of service"
                            : root.page == 6 ? "Set up encrypted messaging"
                            : root.retry-storage ? "Open your local identity"
                            : !root.can-retry ? "Account setup needs attention"
                            : "Create your VOID account";
                        color: Theme.primary;
                        font-size: root.heading-size;
                        font-weight: 700;
                        horizontal-alignment: root.onboarding-step ? center : left;
                        wrap: word-wrap;
                    }

                    if root.show-steps: Text {
                        text: root.page == 1 ? "Create your VOID account to get a VOID-ID."
                            : root.page == 2 ? "Your VOID-ID is the public identifier issued by VOID.\nYour private account key proves ownership."
                            : root.page == 3 ? "Windows protects your private key under your Windows user profile.\nKeep your local VOID data. Account recovery is unavailable in this release."
                            : root.page == 4 ? "The final Terms of Service are unavailable in this preview.\nThe next step lets you choose whether to register a real VOID account."
                            : "VOID verifies ownership with your public key.\nYour private key stays on this device.";
                        color: Theme.secondary;
                        font-size: 16px;
                        horizontal-alignment: root.onboarding-step ? center : left;
                        wrap: word-wrap;
                    }
                    if root.page == 6: Text {
                        text: "Your VOID-ID is saved. Messaging starts once your public encryption keys are confirmed.";
                        color: Theme.secondary;
                        font-size: 16px;
                        wrap: word-wrap;
                    }
                    if root.page == 3: HorizontalLayout {
                        alignment: center;
                        CheckBox {
                            min-height: 44px;
                            enabled: root.active;
                            text: "I understand how my account key is protected.";
                            checked <=> root.security-acknowledged;
                        }
                    }
                    if root.page == 4: HorizontalLayout {
                        alignment: center;
                        CheckBox {
                            min-height: 44px;
                            enabled: root.active;
                            text: "I understand the current preview limitations.";
                            checked <=> root.terms-acknowledged;
                        }
                    }
                    if root.active && root.busy: HorizontalLayout {
                        spacing: 12px;
                        min-height: 44px;
                        Spinner { width: 20px; height: 20px; }
                        WrappingText {
                            text: root.status;
                            color: Theme.secondary;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                    if root.active && root.error != "": WrappingText {
                        text: root.error;
                        color: Theme.error;
                        font-size: 15px;
                    }
                    if root.page == 5 && root.can-retry: HorizontalLayout {
                        alignment: root.onboarding-step ? center : start;
                        padding-top: root.onboarding-step ? 4px : 0px;
                        Action {
                            label: root.action;
                            primary: true;
                            preferred-width: root.onboarding-step ? 208px : self.min-width;
                            enabled: root.active && !root.busy;
                            clicked => { root.submit(); }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

component AccountSetup inherits Rectangle {
    in-out property <int> page;
    in property <bool> busy;
    in property <bool> can-retry;
    in property <bool> retry-storage;
    in property <string> status;
    in property <string> error;
    in property <string> action;
    in property <bool> can-remove-local;
    callback submit();
    callback remove-local();

    private property <bool> security-acknowledged;
    private property <bool> terms-acknowledged;
    private property <bool> show-steps: root.page > 0 && root.page <= 5 && !root.retry-storage && root.can-retry;
    private property <length> gutter: max(24px, (root.width - root.reading-width) / 2);
    private property <length> reading-width: 600px;
    private property <float> slide-position: max(0, root.page);
    animate slide-position { duration: 360ms; easing: ease-in-out; }

    background: Theme.background;

    Rectangle {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            Rectangle {
                height: 80px;
                background: Theme.sidebar;

                HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    spacing: 12px;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: Theme.accent;
                        Text {
                            text: "V";
                            color: Theme.sidebar;
                            font-size: 21px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: "VOID";
                        color: Theme.primary;
                        font-size: 20px;
                        font-weight: 800;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.divider; }
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Move all pages together so outgoing and incoming content cannot overlap.
                for step in [-1, 1, 2, 3, 4, 5, 6]: SetupPage {
                    x: (max(0, step) - root.slide-position) * self.width;
                    visible: self.x > -self.width && self.x < self.width;
                    width: parent.width;
                    height: parent.height;
                    page: step;
                    current-page: root.page;
                    show-steps: root.show-steps;
                    busy: root.busy;
                    can-retry: root.can-retry;
                    retry-storage: root.retry-storage;
                    status: root.status;
                    error: root.error;
                    action: root.action;
                    submit => { root.submit(); }
                    security-acknowledged <=> root.security-acknowledged;
                    terms-acknowledged <=> root.terms-acknowledged;
                    gutter: root.gutter;
                    reading-width: root.reading-width;
                    heading-size: root.width < 960px ? 32px : 38px;
                    top-padding: root.height < 600px ? 40px : 64px;
                }
            }

            if root.page > 0 && (root.show-steps || (root.page == 6 && root.can-retry) || root.can-remove-local): Rectangle {
                height: 84px;
                background: Theme.sidebar;

                Rectangle { y: 0; height: 1px; background: Theme.divider; }

                if root.show-steps: HorizontalLayout {
                    alignment: center;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 8px;

                    for step[index] in ["Welcome", "How VOID works", "Security notice", "Terms of service", "Create account"]: HorizontalLayout {
                        spacing: 8px;
                        if index > 0: Rectangle {
                            width: 14px;
                            height: 1px;
                            y: (parent.height - self.height) / 2;
                            background: index < root.page ? Theme.accent : Theme.divider;
                        }
                        SetupStep {
                            y: (parent.height - self.height) / 2;
                            label: step;
                            number: index + 1;
                            current-page: root.page;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 12px;

                    if root.page > 1 && root.page <= 5 && (root.page < 5 || (root.error == "" && !root.retry-storage)): Action {
                        label: "Back";
                        enabled: !root.busy;
                        clicked => { root.page -= 1; }
                    }
                    if root.can-remove-local: Action {
                        label: "Remove from this device";
                        clicked => { root.remove-local(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.page < 5: Action {
                        label: root.page == 1 ? "Get started" : "Continue";
                        primary: true;
                        enabled: (root.page != 3 || root.security-acknowledged)
                            && (root.page != 4 || root.terms-acknowledged);
                        clicked => { root.page += 1; }
                    }
                    if root.page == 6 && root.can-retry: Action {
                        label: root.action;
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.submit(); }
                    }
                }
            }
        }
    }
}
export component AppWindow inherits Window {
    title: root.setup-page == 0 ? "VOID" : "VOID — Account setup";
    preferred-width: 1080px;
    preferred-height: 680px;
    min-width: 850px;
    min-height: 560px;
    background: Theme.background;
    in property <string> account-void-id;
    in property <string> timeline-today;
    in property <string> timeline-yesterday;
    in-out property <int> setup-page: -1;
    in property <bool> setup-busy: true;
    in property <bool> setup-can-retry: true;
    in property <bool> setup-retry-storage;
    in property <string> setup-status: "Opening protected local storage…";
    in property <string> setup-error;
    in property <string> setup-action: "Create account";
    callback submit-setup();
    callback account-registered();
    in property <string> connection-status: "Disconnected";
    out property <bool> can-reconnect: root.storage-ready
        && (root.connection-status == "Disconnected" || root.connection-status == "Reconnecting"
            || root.connection-status == "Authentication failed");
    callback reconnect();
    in property <bool> messaging-ready;
    in property <bool> publishing-keys;
    in property <string> publication-error;
    in property <bool> publication-retryable;
    in property <bool> send-busy;
    in property <string> messaging-notice;
    callback storage-opened();
    callback retry-messaging();
    callback send-message();
    callback resend-message(string);
    callback read-visible-conversation(string, string);
    callback draft-queued(string, string, int);

    in-out property <string> section: "Chats";

    in property <bool> storage-ready;
    in property <bool> storage-loading: true;
    in property <bool> storage-retryable;
    in property <string> storage-error;
    in property <[StoredConversation]> stored-chats;
    in property <bool> chats-unread;
    in property <bool> requests-unread;
    in property <bool> window-foreground;
    in property <[StoredConversation]> stored-requests;
    in property <[StoredContact]> stored-contacts;
    in property <[StoredMessage]> stored-messages;
    in property <string> selected-conversation;
    in property <string> conversation-title;
    in property <string> conversation-read-through;
    in property <bool> conversation-is-request;
    in property <bool> conversation-peer-deleted;
    in-out property <bool> conversation-loading;
    in-out property <bool> creating-conversation;
    in-out property <string> conversation-error;
    in-out property <string> stored-draft;
    pure callback has-message-content(string) -> bool;
    private property <bool> can-send-draft:
        !root.send-busy && !root.conversation-loading && root.has-message-content(root.stored-draft);
    in property <string> draft-status;
    in property <bool> draft-save-failed;
    in property <bool> unsaved-draft-failure;
    in-out property <int> storage-selection-token;
    in property <int> storage-draft-token;
    callback retry-storage();
    callback select-stored-conversation(string);
    callback create-stored-conversation(string);
    callback save-stored-draft(string);
    callback load-stored-draft(string, string);
    callback report-draft-saved(string, int, bool);

    in-out property <string> permanent-deletion-phrase;
    out property <bool> permanent-deletion-open: false;
    out property <bool> permanent-deletion-confirmed:
        root.permanent-deletion-open && root.permanent-deletion-phrase == "DELETE";
    in property <bool> account-management-ready;
    out property <bool> can-permanently-delete:
        root.account-management-ready && root.in-settings && root.account-void-id != "" && !root.removal-busy
        && root.removal-error == "" && root.permanent-deletion-confirmed;
    callback open-permanent-deletion();
    callback cancel-permanent-deletion();
    in-out property <string> local-removal-phrase;
    out property <bool> local-removal-open: false;
    out property <bool> local-removal-confirmed:
        root.can-open-local-removal && root.local-removal-open && root.local-removal-phrase == "DELETE";
    in property <bool> removal-busy;
    in property <string> removal-error;
    in property <bool> removal-can-go-back;
    in property <bool> removal-permanent;
    in property <string> removal-status;
    callback open-local-removal();
    callback cancel-local-removal();
    callback request-account-removal(bool);
    callback leave-failed-removal();

    open-permanent-deletion => {
        if root.in-settings && root.account-void-id != "" {
            root.cancel-local-removal();
            root.permanent-deletion-phrase = "";
            root.permanent-deletion-open = true;
        }
    }
    cancel-permanent-deletion => {
        root.permanent-deletion-open = false;
        root.permanent-deletion-phrase = "";
    }
    open-local-removal => {
        if root.can-open-local-removal {
            root.cancel-permanent-deletion();
            root.local-removal-phrase = "";
            root.local-removal-open = true;
        }
    }
    cancel-local-removal => {
        root.local-removal-open = false;
        root.local-removal-phrase = "";
    }

    private property <[StoredConversation]> visible-conversations: root.section == "Requests"
        ? root.stored-requests : root.stored-chats;
    private property <bool> show-conversation: root.selected-conversation != "" && !root.creating-conversation
        && ((root.section == "Requests" && root.conversation-is-request)
            || (root.section == "Chats" && !root.conversation-is-request));
    out property <bool> conversation-can-compose: root.show-conversation && !root.conversation-peer-deleted;
    private property <bool> timeline-at-end: true;
    private property <string> timestamp-tip;
    private property <int> timestamp-tip-row: -1;
    private property <length> timestamp-tip-x;
    private property <length> timestamp-tip-y;

    changed stored-messages => { root.timestamp-tip = ""; }
    changed width => { root.timestamp-tip = ""; }
    changed height => { root.timestamp-tip = ""; }
    private property <string> visible-read-through:
        root.window-foreground && root.show-conversation && !root.conversation-loading
            && root.setup-page == 0 && !root.showing-account-removal && root.timeline-at-end
        ? root.conversation-read-through : "";
    changed visible-read-through => {
        if root.visible-read-through != "" {
            root.read-visible-conversation(root.selected-conversation, root.visible-read-through);
        }
    }
    out property <string> conversation-account-notice: root.show-conversation && root.conversation-peer-deleted
        ? "This user account has been deleted." : "";

    changed section => {
        root.cancel-permanent-deletion();
        root.cancel-local-removal();
        root.timestamp-tip = "";
    }
    changed settings-section => { root.cancel-permanent-deletion(); root.cancel-local-removal(); }
    changed in-settings => {
        if !root.in-settings { root.cancel-permanent-deletion(); }
    }
    changed can-open-local-removal => {
        if !root.can-open-local-removal { root.cancel-local-removal(); }
    }

    function navigate(section: string) {
        if root.section != section {
            root.section = section;
            root.creating-conversation = false;
            root.conversation-error = "";
            root.storage-selection-token += 1;
            root.conversation-loading = false;
        }
    }

    private property <bool> compact: self.width < 1000px;
    private property <string> settings-section: "Appearance";
    private property <length> collapsed-rail-width: 64px;
    private property <length> list-start: root.collapsed-rail-width + 1px;
    private property <length> requested-list-width: 280px;
    private property <length> divider-width: 9px;
    private property <length> min-list-width: 220px;
    private property <length> min-chat-width: root.compact ? 380px : 420px;
    private property <length> max-list-width: min(480px, root.width - root.list-start - root.divider-width - root.min-chat-width);
    private property <length> list-width: clamp(root.requested-list-width, root.min-list-width, root.max-list-width);
    private property <length> header-height: root.compact ? 64px : 72px;
    private property <length> list-gutter: root.compact ? 12px : 16px;
    private property <length> chat-gutter: root.compact ? 20px : 28px;
    private property <bool> enrolling: root.setup-page == 6;
    private property <bool> in-settings: root.setup-page == 0 && root.section == "Settings";
    out property <bool> can-remove-enrollment-account: root.enrolling && root.account-void-id != ""
        && !root.enrollment-busy && root.enrollment-error != "";
    private property <bool> can-open-local-removal: root.account-void-id != ""
        && (root.in-settings || root.can-remove-enrollment-account);
    private property <bool> showing-account-removal: root.permanent-deletion-open || root.local-removal-open
        || root.removal-busy || root.removal-error != "";
    out property <bool> enrollment-can-retry: root.enrolling && !root.storage-loading
        && ((root.storage-error != "" && root.storage-retryable)
            || root.connection-status == "Authentication failed"
            || (root.connection-status == "Connected" && root.publication-retryable));
    private property <bool> enrollment-busy: root.storage-loading || root.publishing-keys
        || root.connection-status == "Connecting" || root.connection-status == "Reconnecting";
    private property <string> enrollment-status: root.storage-loading ? root.setup-status
        : root.publishing-keys ? "Publishing encryption keys…"
        : root.connection-status == "Reconnecting" ? "Waiting for the relay to reconnect…"
        : "Connecting to the relay…";
    private property <string> enrollment-error: root.storage-error != "" ? root.storage-error
        : root.connection-status == "Authentication failed" ? "VOID could not authenticate with the relay. Retry to continue enrollment."
        : root.publication-error;

    if root.showing-account-removal: AccountRemovalPage {
        permanent: root.permanent-deletion-open || root.removal-permanent;
        busy: root.removal-busy;
        status: root.removal-status;
        error: root.removal-error;
        can-go-back: root.removal-can-go-back;
        phrase: self.permanent ? root.permanent-deletion-phrase : root.local-removal-phrase;
        can-confirm: self.permanent ? root.can-permanently-delete : root.local-removal-confirmed;
        edit-phrase(text) => {
            if self.permanent { root.permanent-deletion-phrase = text; }
            else { root.local-removal-phrase = text; }
        }
        cancel => {
            if root.removal-error != "" {
                root.leave-failed-removal();
            } else {
                root.cancel-local-removal();
                root.cancel-permanent-deletion();
            }
        }
        confirm => { root.request-account-removal(self.permanent); }
    }

    if root.setup-page != 0 && !root.showing-account-removal: AccountSetup {
        page <=> root.setup-page;
        busy: root.enrolling ? root.enrollment-busy : root.setup-busy;
        can-retry: root.enrolling ? root.enrollment-can-retry : root.setup-can-retry;
        retry-storage: root.setup-retry-storage;
        status: root.enrolling ? root.enrollment-status : root.setup-status;
        error: root.enrolling ? root.enrollment-error : root.setup-error;
        action: root.enrolling ? "Retry" : root.setup-action;
        can-remove-local: root.can-remove-enrollment-account;
        remove-local => { root.open-local-removal(); }
        submit => {
            if !root.enrolling {
                root.submit-setup();
            } else if root.enrollment-can-retry {
                if root.storage-error != "" {
                    root.retry-storage();
                } else if root.connection-status == "Authentication failed" {
                    root.reconnect();
                } else {
                    root.retry-messaging();
                }
            }
        }
    }

    if root.setup-page == 0 && !root.showing-account-removal: Rectangle {
        sidebar := Rectangle {
            private property <bool> section-hovered: main-navigation.has-hover || settings-navigation.has-hover;
            private property <length> expanded-width: 168px;
            private property <float> reveal-progress: clamp(
                (self.width - root.collapsed-rail-width) / (self.expanded-width - root.collapsed-rail-width), 0, 1);
            private property <float> label-opacity: self.reveal-progress * self.reveal-progress *
                (3 - 2 * self.reveal-progress);
            x: 0;
            width: self.section-hovered ? self.expanded-width : root.collapsed-rail-width;
            z: 1;
            background: Theme.sidebar;
            clip: true;
            animate width {
                duration: sidebar.section-hovered ? 180ms : 150ms;
                easing: ease-in-out;
            }

            // Keep clicks on the overlay from reaching the covered pane.
            TouchArea {}

            VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    Rectangle {
                        x: 14px;
                        y: (parent.height - self.height) / 2;
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: Theme.accent;
                        Text {
                            text: "V";
                            color: Theme.sidebar;
                            font-size: 21px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    Text {
                        x: 62px;
                        width: self.preferred-width;
                        opacity: sidebar.label-opacity;
                        text: "VOID";
                        color: Theme.primary;
                        font-size: 20px;
                        font-weight: 800;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Theme.divider; }

                main-navigation := TouchArea {
                    height: main-buttons.min-height;

                    main-buttons := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        NavItem {
                            label: "Chats";
                            icon: NavIcon.chats;
                            unread: root.chats-unread;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Chats";
                            clicked => { root.navigate("Chats"); }
                        }
                        NavItem {
                            label: "Requests";
                            icon: NavIcon.requests;
                            unread: root.requests-unread;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Requests";
                            clicked => { root.navigate("Requests"); }
                        }
                        NavItem {
                            label: "Contacts";
                            icon: NavIcon.contacts;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Contacts";
                            clicked => { root.navigate("Contacts"); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                settings-navigation := TouchArea {
                    height: settings-buttons.min-height;

                    settings-buttons := VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        Rectangle { height: 1px; background: Theme.divider; }
                        NavItem {
                            label: "Settings";
                            icon: NavIcon.settings;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Settings";
                            clicked => { root.navigate("Settings"); }
                        }
                    }
                }
            }
        }

        Rectangle { x: sidebar.width; z: 1; width: 1px; background: Theme.divider; }

        list-pane := Rectangle {
            x: root.list-start;
            width: root.list-width;
            background: Theme.surface;

            VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    HorizontalLayout {
                        padding-left: root.list-gutter;
                        padding-right: root.list-gutter;
                        padding-top: (root.header-height - 44px) / 2;
                        padding-bottom: self.padding-top;
                        spacing: 8px;

                        Text {
                            text: root.section;
                            color: Theme.primary;
                            font-size: 22px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.storage-ready && root.section == "Chats": Action {
                            label: "+ New";
                            primary: true;
                            enabled: !root.conversation-loading;
                            clicked => {
                                root.conversation-error = "";
                                root.creating-conversation = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.divider; }

                PaneScroll {
                    VerticalLayout {
                        alignment: start;
                        padding: root.list-gutter;
                        spacing: 8px;

                        if root.unsaved-draft-failure: WrappingText {
                            text: "A draft could not be saved. Reopen its conversation to retry.";
                            color: Theme.error;
                            font-size: 12px;
                        }
                        if root.messaging-notice != "": WrappingText {
                            text: root.messaging-notice;
                            color: Theme.error;
                            font-size: 12px;
                        }
                        if root.publication-error != "": WrappingText {
                            text: root.publication-error;
                            color: Theme.error;
                            font-size: 12px;
                        }
                        if root.publication-retryable && root.connection-status == "Connected": Action {
                            label: "Retry messaging";
                            clicked => { root.retry-messaging(); }
                        }

                        if root.section == "Settings": VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            for category in ["Appearance", "Account", "About"]: Action {
                                label: category;
                                selected: root.settings-section == category;
                                clicked => { root.settings-section = category; }
                            }
                        }
                        if root.section != "Settings" && !root.storage-ready: WrappingText {
                            text: root.storage-loading ? "Opening encrypted storage…" : root.storage-error;
                            color: root.storage-loading ? Theme.secondary : Theme.error;
                            font-size: 13px;
                        }
                        if root.section != "Settings" && !root.storage-ready && !root.storage-loading: Action {
                            label: "Try again";
                            clicked => { root.retry-storage(); }
                        }

                        if root.section != "Settings" && root.storage-ready: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            if root.section == "Contacts" ? root.stored-contacts.length == 0 : root.visible-conversations.length == 0: Text {
                                text: root.section == "Requests" ? "No incoming requests"
                                    : root.section == "Contacts" ? "No contacts yet" : "No conversations yet";
                                color: Theme.secondary;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            if root.section == "Contacts": VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                for contact in root.stored-contacts: StorageRow {
                                    label: contact.title;
                                    detail: contact.void-id;
                                    enabled: !root.conversation-loading;
                                    clicked => { root.create-stored-conversation(contact.void-id); }
                                }
                            }
                            if root.section != "Contacts": VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                for chat in root.visible-conversations: StorageRow {
                                    label: chat.title;
                                    detail: chat.preview;
                                    activity: chat.activity;
                                    unread: chat.unread;
                                    selected: root.show-conversation && root.selected-conversation == chat.id;
                                    enabled: !root.conversation-loading;
                                    clicked => {
                                        root.creating-conversation = false;
                                        root.select-stored-conversation(chat.id);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.publication-error == "" && root.connection-status == "Connected": VerticalLayout {
                    alignment: start;
                    padding-left: root.list-gutter;
                    padding-right: root.list-gutter;
                    padding-bottom: 8px;
                    Text {
                        text: root.messaging-ready ? "Messaging ready" : "Preparing messaging…";
                        color: Theme.secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                HorizontalLayout {
                    min-height: 56px;
                    vertical-stretch: 0;
                    padding-left: root.list-gutter;
                    padding-right: root.list-gutter;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;

                    WrappingText {
                        text: root.connection-status == "Connected" ? "Relay authenticated" : root.connection-status;
                        accessible-label: "Relay connection: " + self.text;
                        color: root.connection-status == "Authentication failed" ? Theme.error
                            : root.connection-status == "Connected" ? Theme.accent : Theme.secondary;
                        font-size: 12px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if root.can-reconnect: Action {
                        label: "Reconnect";
                        enabled: !root.send-busy;
                        clicked => { root.reconnect(); }
                    }
                }
            }
        }

        divider := TouchArea {
            x: list-pane.x + list-pane.width;
            width: root.divider-width;
            mouse-cursor: col-resize;
            forward-focus: resize-focus;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down { resize-focus.focus(); }
            }
            moved => {
                if self.pressed {
                    root.requested-list-width = clamp(list-pane.width + self.mouse-x - self.pressed-x,
                        root.min-list-width, root.max-list-width);
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                width: divider.pressed || divider.has-hover || resize-focus.has-focus ? 2px : 1px;
                background: divider.pressed || divider.has-hover || resize-focus.has-focus ? Theme.accent : Theme.divider;
            }

            resize-focus := FocusScope {
                width: 0;
                key-pressed(event) => {
                    if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        root.requested-list-width = clamp(list-pane.width + (event.text == Key.LeftArrow ? -16px : 16px),
                            root.min-list-width, root.max-list-width);
                        return accept;
                    }
                    return reject;
                }
            }
        }

        chat-pane := Rectangle {
            private property <length> thread-gutter: max(root.chat-gutter, (self.width - 1080px) / 2);
            x: divider.x + divider.width;
            width: parent.width - self.x;

            if root.section == "Settings": VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    background: Theme.surface;
                    Text {
                        x: root.chat-gutter;
                        text: root.settings-section;
                        color: Theme.primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                PaneScroll {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: root.chat-gutter;
                        padding-right: max(root.chat-gutter, chat-pane.width - root.chat-gutter - 680px);
                        spacing: 16px;
                        SettingDetail {
                            label: root.settings-section == "Appearance" ? "Theme"
                                : root.settings-section == "Account" ? "VOID-ID" : "VOID";
                            value: root.settings-section == "Appearance" ? "Dark"
                                : root.settings-section == "Account" ? root.account-void-id : "Native app";
                            description: root.settings-section == "Appearance" ? "Uses the VOID dark palette." : "";
                        }
                        if root.settings-section == "Account" && root.account-void-id != "": VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Text {
                                text: "Account removal";
                                color: Theme.primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: "Clear local keys, conversations, and drafts. Your VOID-ID stays registered.";
                                    color: Theme.secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Action {
                                        label: "Remove from this device";
                                        clicked => { root.open-local-removal(); }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: "Deactivate your VOID-ID and remove this device’s data after the relay confirms deletion.";
                                    color: Theme.secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Action {
                                        label: "Delete account permanently";
                                        destructive: true;
                                        clicked => { root.open-permanent-deletion(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.section != "Settings" && !root.creating-conversation && !root.show-conversation: PaneScroll {
                VerticalLayout {
                    padding-left: max(root.chat-gutter, (chat-pane.width - 460px) / 2);
                    padding-right: self.padding-left;
                    padding-top: root.chat-gutter;
                    padding-bottom: root.chat-gutter;
                    alignment: center;

                    WrappingText {
                        text: root.conversation-error != "" ? root.conversation-error
                            : root.conversation-loading ? "Loading conversation…"
                            : !root.storage-ready ? ""
                            : root.section == "Chats" ? "Open a local conversation to view its history or write a draft."
                            : root.section == "Requests" ? "Open a saved request to view it here."
                            : "Open a saved contact to view their conversation.";
                        color: root.conversation-error != "" ? Theme.error : Theme.secondary;
                        font-size: 16px;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.creating-conversation && root.section == "Chats": PaneScroll {
                VerticalLayout {
                    alignment: start;
                    padding: root.chat-gutter;
                    padding-right: max(root.chat-gutter, chat-pane.width - root.chat-gutter - 500px);
                    spacing: 12px;

                    Text { text: "New local conversation"; color: Theme.primary; font-size: 20px; font-weight: 700; }
                    WrappingText {
                        text: "Enter the recipient’s VOID-ID to open a conversation.";
                        color: Theme.secondary;
                        font-size: 13px;
                    }
                    Text { text: "Peer VOID-ID"; color: Theme.primary; font-size: 14px; }
                    peer := LineEdit {
                        accessible-label: "Peer VOID-ID";
                        height: 44px;
                        enabled: !root.conversation-loading;
                        edited => { root.conversation-error = ""; }
                        accepted => { root.create-stored-conversation(self.text); }
                    }
                    if root.conversation-error != "": WrappingText {
                        text: root.conversation-error;
                        color: Theme.error;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Action {
                            label: "Cancel";
                            enabled: !root.conversation-loading;
                            clicked => { root.creating-conversation = false; root.conversation-error = ""; }
                        }
                        Action {
                            label: root.conversation-loading ? "Opening…" : "Open conversation";
                            primary: true;
                            enabled: !root.conversation-loading && peer.text != "";
                            clicked => { root.create-stored-conversation(peer.text); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            if root.show-conversation: VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: root.chat-gutter;
                        padding-right: root.chat-gutter;
                        spacing: 10px;
                        Rectangle {
                            width: 34px;
                            UserAvatar { y: (parent.height - self.height) / 2; }
                        }
                        Text {
                            text: root.conversation-title;
                            color: Theme.primary;
                            font-size: 16px;
                            font-weight: 700;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                if root.conversation-loading || root.conversation-error != "": PaneScroll {
                    height: min(notice.min-height, 100px);
                    notice := VerticalLayout {
                        alignment: start;
                        padding-left: root.chat-gutter;
                        padding-right: root.chat-gutter;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        WrappingText {
                            text: root.conversation-loading ? "Loading conversation…" : root.conversation-error;
                            color: root.conversation-loading ? Theme.secondary : Theme.error;
                            horizontal-alignment: center;
                        }
                    }
                }

                timeline := PaneScroll {
                    min-height: 72px;
                    private property <bool> follow-latest: true;
                    private property <length> end-offset: min(0px, self.visible-height - self.content-height);
                    private property <string> conversation: root.selected-conversation;

                    init => { root.timeline-at-end = true; }
                    changed follow-latest => { root.timeline-at-end = self.follow-latest; }
                    changed conversation => {
                        self.follow-latest = true;
                        self.content-y = self.end-offset;
                    }
                    changed content-y => { root.timestamp-tip = ""; }
                    changed end-offset => {
                        if self.end-offset == 0px { self.follow-latest = true; }
                        self.content-y = self.follow-latest ? self.end-offset
                            : clamp(self.content-y, self.end-offset, 0px);
                    }
                    scrolled => {
                        self.follow-latest = self.content-y <= self.end-offset + 8px;
                    }

                    content-height: max(self.visible-height, history.min-height);

                    history := VerticalLayout {
                        alignment: root.stored-messages.length == 0 ? center : end;
                        padding-left: chat-pane.thread-gutter;
                        padding-right: chat-pane.thread-gutter;
                        padding-top: root.chat-gutter;
                        padding-bottom: root.chat-gutter;
                        spacing: 6px;
                        if root.stored-messages.length == 0: Text {
                            text: "No saved messages";
                            color: Theme.secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                        for message[index] in root.stored-messages: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            if message.day != "": HorizontalLayout {
                                spacing: 10px;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }
                                Text {
                                    text: message.day == root.timeline-today ? "Today"
                                        : message.day == root.timeline-yesterday ? "Yesterday" : message.day;
                                    color: Theme.secondary;
                                    font-size: 11px;
                                    horizontal-stretch: 0;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: message.outgoing ? end : start;
                                MessageBubble {
                                    message: message;
                                    width-limit: min(440px, (chat-pane.width - 2 * chat-pane.thread-gutter) * 0.86);
                                    show-retry: !root.conversation-peer-deleted && message.retry-event != "";
                                    retry-enabled: root.messaging-ready && !root.send-busy;
                                    retry => { root.resend-message(message.retry-event); }
                                    timestamp-hovered(label, x, y) => {
                                        root.timestamp-tip-row = index;
                                        root.timestamp-tip-x = x;
                                        root.timestamp-tip-y = y;
                                        root.timestamp-tip = label;
                                    }
                                    timestamp-left => {
                                        if root.timestamp-tip-row == index {
                                            root.timestamp-tip = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                if root.conversation-account-notice != "": VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    padding: 12px;
                    padding-left: chat-pane.thread-gutter;
                    padding-right: chat-pane.thread-gutter;
                    spacing: 4px;
                    Text { text: root.conversation-account-notice; color: Theme.primary; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                    Text { text: "You can no longer send messages to this account."; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                }
                if root.conversation-can-compose: VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    padding: 8px;
                    padding-left: chat-pane.thread-gutter;
                    padding-right: chat-pane.thread-gutter;
                    spacing: 8px;

                    if root.draft-save-failed: HorizontalLayout {
                        spacing: 8px;
                        WrappingText {
                            text: root.draft-status;
                            color: Theme.error;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Action {
                            label: "Retry saving";
                            enabled: !root.conversation-loading;
                            clicked => { root.save-stored-draft(root.stored-draft); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        editor := TextEdit {
                            accessible-label: "Message. Enter to send. Shift+Enter for a new line.";
                            placeholder-text: "Write a message…";
                            height: clamp(draft-measure.preferred-height + 24px, 44px, 92px);
                            font-size: 14px;
                            wrap: word-wrap;
                            enabled: !root.conversation-loading;
                            text <=> root.stored-draft;
                            edited(text) => { root.save-stored-draft(text); }
                            key-pressed(event) => {
                                if event.text == Key.Return && !event.modifiers.shift {
                                    if root.can-send-draft { root.send-message(); }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        Rectangle {
                            width: 86px;
                            min-height: 44px;
                            Action {
                                label: root.send-busy ? "Sending…" : "Send";
                                y: parent.height - self.height;
                                width: parent.width;
                                primary: true;
                                enabled: root.can-send-draft;
                                clicked => { root.send-message(); }
                            }
                            draft-measure := WrappingText {
                                visible: false;
                                // Measure within the native input padding, including a trailing newline.
                                width: max(1px, editor.width - 24px);
                                text: root.stored-draft + " ";
                                font-size: editor.font-size;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.timestamp-tip != "" && root.show-conversation && root.setup-page == 0
        && !root.showing-account-removal: Rectangle {
        z: 5;
        width: tooltip-text.preferred-width + 20px;
        height: tooltip-text.preferred-height + 12px;
        x: clamp(root.timestamp-tip-x - self.width / 2, 8px, root.width - self.width - 8px);
        y: root.timestamp-tip-y >= self.height + 8px
            ? root.timestamp-tip-y - self.height - 5px : root.timestamp-tip-y + 18px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.divider;
        background: Theme.surface;
        tooltip-text := Text {
            text: root.timestamp-tip;
            color: Theme.primary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
