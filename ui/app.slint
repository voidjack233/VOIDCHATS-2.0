import { CheckBox, LineEdit, ScrollView, Spinner, TextEdit } from "std-widgets.slint";

export struct StoredConversation { id: string, title: string, activity: string }
export struct StoredContact { title: string, void-id: string }
export struct StoredMessage { body: string, time: string, outgoing: bool, status: string, retry-event: string }

global Theme {
    out property <color> background: #0c1118;
    out property <color> surface: #151c25;
    out property <color> elevated: #1d2732;
    out property <color> primary: #f4f6f8;
    out property <color> secondary: #b0bac5;
    out property <color> accent: #95afe9;
    out property <color> sidebar: #101720;
    out property <color> divider: #26313d;
    out property <color> selected: #263448;
    out property <color> outgoing: #344969;
    out property <color> error: #ffb4a9;
}

component Clickable inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected;
    out property <bool> hovered: hit-area.has-hover;
    out property <bool> pressed: hit-area.pressed;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: key-focus;
    border-radius: 10px;
    border-width: key-focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    background: root.pressed ? Theme.outgoing : root.selected ? Theme.selected : root.hovered ? Theme.elevated : transparent;

    hit-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { key-focus.focus(); root.clicked(); }
    }
    key-focus := FocusScope {
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component Action inherits Clickable {
    in property <bool> primary;
    height: 44px;
    min-width: action-text.preferred-width + 28px;
    horizontal-stretch: 0;
    background: !root.enabled ? Theme.elevated
        : root.primary && !root.pressed && !root.hovered ? Theme.accent
        : root.pressed ? Theme.outgoing : root.selected || root.hovered ? Theme.selected : Theme.elevated;

    action-text := Text {
        text: root.label;
        color: !root.enabled ? Theme.secondary
            : root.primary && !root.pressed && !root.hovered ? Theme.background : Theme.primary;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

enum NavIcon { chats, requests, contacts, settings }

component NavItem inherits Clickable {
    in property <NavIcon> icon;
    in property <float> label-opacity;
    height: 44px;
    clip: true;

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: root.icon == NavIcon.chats ? @image-url("icons/chats.svg")
            : root.icon == NavIcon.requests ? @image-url("icons/requests.svg")
            : root.icon == NavIcon.contacts ? @image-url("icons/contacts.svg")
            : @image-url("icons/settings.svg");
        colorize: root.selected ? Theme.accent : Theme.secondary;
        accessible-role: none;
    }

    if root.selected: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Theme.accent;
    }

    Text {
        x: 44px;
        width: self.preferred-width;
        opacity: root.label-opacity;
        text: root.label;
        color: root.selected ? Theme.primary : Theme.secondary;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: clip;
        accessible-role: none;
    }
}

component SettingDetail inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> description;
    min-height: content.min-height;
    background: Theme.elevated;
    border-radius: 12px;

    content := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: root.label; color: Theme.primary; font-size: 14px; font-weight: 600; }
        Text { text: root.value; color: Theme.accent; font-size: 14px; }
        if root.description != "": Text { text: root.description; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
    }
}

component AccountRemovalPage inherits Rectangle {
    in property <bool> permanent;
    in property <bool> busy;
    in property <string> error;
    in property <string> phrase;
    in property <bool> can-confirm;
    in property <bool> can-go-back;
    callback edit-phrase(string);
    callback confirm();
    callback cancel();
    private property <length> gutter: max(40px, (root.width - 600px) / 2);

    ScrollView {
        width: parent.width;
        height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        VerticalLayout {
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: 44px;
            padding-bottom: 28px;
            spacing: 14px;
            Text {
                text: root.permanent ? "Delete account permanently" : "Remove from this device";
                color: Theme.primary;
                font-size: 30px;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.busy: HorizontalLayout {
                spacing: 12px;
                Spinner { width: 20px; height: 20px; }
                Text { text: "Removing this device’s VOID data…"; color: Theme.secondary; }
            }
            if root.error != "": Text { text: root.error; color: Theme.error; wrap: word-wrap; }
            if !root.busy && root.error == "": VerticalLayout {
                spacing: 12px;
                Text {
                    text: root.permanent
                        ? "Your VOID-ID will be permanently deactivated. Other users will no longer be able to message you. This cannot be undone."
                        : "VOID will remove your saved credentials, encryption keys, conversations, and drafts from this Windows profile. This cannot be undone.";
                    color: Theme.primary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.permanent
                        ? "Previous conversations will remain on other users’ devices. The server’s deletion protocol will handle queued messages and public prekeys."
                        : "Your VOID-ID and server account will remain registered. VOID will return to the welcome screen.";
                    color: Theme.secondary;
                    wrap: word-wrap;
                }
                if root.permanent: Text {
                    text: "VOID will remove this device’s credentials, Signal keys, and conversations after the server confirms deletion.";
                    color: Theme.secondary;
                    wrap: word-wrap;
                }
                Text { text: "Type DELETE to confirm"; color: Theme.primary; font-weight: 600; }
                LineEdit {
                    accessible-label: "Type DELETE to confirm";
                    height: 44px;
                    text: root.phrase;
                    edited(text) => { root.edit-phrase(text); }
                }
                if root.permanent: Text {
                    text: "Permanent deletion is unavailable until the server supports authenticated account deletion.";
                    color: Theme.secondary;
                    wrap: word-wrap;
                }
            }
            if !root.busy: HorizontalLayout {
                spacing: 8px;
                if root.error == "" || root.can-go-back: Action {
                    label: root.error == "" ? "Cancel" : "Back to setup";
                    clicked => { root.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Action {
                    label: root.error != "" ? "Retry local removal"
                        : root.permanent ? "Delete account permanently" : "Remove from this device";
                    enabled: root.error != "" || root.can-confirm;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

component StorageRow inherits Clickable {
    in property <string> detail;
    height: 58px;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.primary;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.secondary;
            font-size: 12px;
            overflow: elide;
        }
    }
}

component SetupStep inherits Rectangle {
    in property <string> label;
    in property <int> number;
    in property <int> current-page;
    private property <bool> current: root.number == root.current-page;
    private property <bool> completed: root.number < root.current-page;

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: root.current ? Theme.accent : Theme.elevated;
    accessible-role: text;
    accessible-label: root.label + (root.current ? ", current step" : root.completed ? ", completed" : "");
    animate background { duration: 160ms; easing: ease-out; }

    Text {
        text: root.completed ? "✓" : "" + root.number;
        color: root.current ? Theme.background : root.completed ? Theme.accent : Theme.secondary;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component SetupPage inherits Rectangle {
    in property <int> page;
    in property <int> current-page;
    in property <bool> show-steps;
    in property <bool> busy;
    in property <bool> can-retry;
    in property <bool> retry-storage;
    in property <string> status;
    in property <string> error;
    in-out property <bool> security-acknowledged;
    in-out property <bool> terms-acknowledged;
    in property <length> gutter;
    in property <length> reading-width;
    in property <length> heading-size;
    in property <length> top-padding;

    private property <bool> active: root.page == root.current-page;

    changed active => {
        if root.active { setup-content.content-y = 0px; }
    }

    setup-content := ScrollView {
        width: parent.width;
        height: parent.height;
        enabled: root.active;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;

        VerticalLayout {
            padding-top: root.page == 1 ? setup-content.visible-height * 0.34
                : root.top-padding;
            padding-bottom: 32px;
            padding-left: root.gutter;
            padding-right: root.gutter;

            Rectangle {
                horizontal-stretch: 1;
                max-width: root.reading-width;
                min-height: step-content.min-height;

                step-content := VerticalLayout {
                    spacing: 16px;

                    Text {
                        text: root.page == -1 ? "Opening VOID"
                            : root.page == 1 ? "Welcome to VOID"
                            : root.page == 2 ? "How VOID works"
                            : root.page == 3 ? "Security notice"
                            : root.page == 4 ? "Terms of service"
                            : root.page == 6 ? "Set up encrypted messaging"
                            : root.retry-storage ? "Open your local identity"
                            : !root.can-retry ? "Account setup needs attention"
                            : "Create your VOID account";
                        color: Theme.primary;
                        font-size: root.heading-size;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.show-steps: Text {
                        text: root.page == 1 ? "Create your VOID account to get a VOID-ID."
                            : root.page == 2 ? "Your VOID-ID is the public identifier issued by VOID. Your private account key proves ownership."
                            : root.page == 3 ? "Windows protects your private key under your Windows user profile. Keep your local VOID data. Account recovery is unavailable in this release."
                            : root.page == 4 ? "The final Terms of Service are unavailable in this preview. The next step lets you choose whether to register a real VOID account."
                            : "VOID receives your public key and proof of ownership. Your private key stays on this device.";
                        color: Theme.secondary;
                        font-size: 16px;
                        wrap: word-wrap;
                    }
                    if root.page == 6: Text {
                        text: "Your VOID-ID is saved. Messaging starts once your public encryption keys are confirmed.";
                        color: Theme.secondary;
                        font-size: 16px;
                        wrap: word-wrap;
                    }
                    if root.page == 3: CheckBox {
                        min-height: 44px;
                        enabled: root.active;
                        text: "I understand how my account key is protected.";
                        checked <=> root.security-acknowledged;
                    }
                    if root.page == 4: CheckBox {
                        min-height: 44px;
                        enabled: root.active;
                        text: "I understand the current preview limitations.";
                        checked <=> root.terms-acknowledged;
                    }
                    if root.active && root.busy: HorizontalLayout {
                        spacing: 12px;
                        min-height: 44px;
                        Spinner { width: 20px; height: 20px; }
                        Text {
                            text: root.status;
                            color: Theme.secondary;
                            font-size: 15px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if root.active && root.error != "": Text {
                        text: root.error;
                        color: Theme.error;
                        font-size: 15px;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

component AccountSetup inherits Rectangle {
    in-out property <int> page;
    in property <bool> busy;
    in property <bool> can-retry;
    in property <bool> retry-storage;
    in property <string> status;
    in property <string> error;
    in property <string> action;
    in property <bool> manage-account;
    callback submit();
    callback remove-local();
    callback delete-permanently();

    private property <bool> security-acknowledged;
    private property <bool> terms-acknowledged;
    private property <bool> show-steps: root.page > 0 && root.page <= 5 && !root.retry-storage && root.can-retry;
    private property <length> gutter: max(40px, (root.width - root.reading-width) / 2);
    private property <length> reading-width: 600px;
    private property <float> slide-position: max(0, root.page);
    animate slide-position { duration: 360ms; easing: ease-in-out; }

    background: Theme.background;

    Rectangle {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            Rectangle {
                height: 80px;
                background: Theme.sidebar;

                HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    spacing: 12px;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: Theme.accent;
                        Text {
                            text: "V";
                            color: Theme.sidebar;
                            font-size: 21px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: "VOID";
                        color: Theme.primary;
                        font-size: 20px;
                        font-weight: 800;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.divider; }
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Move all pages together so outgoing and incoming content cannot overlap.
                for step in [-1, 1, 2, 3, 4, 5, 6]: SetupPage {
                    x: (max(0, step) - root.slide-position) * self.width;
                    visible: self.x > -self.width && self.x < self.width;
                    width: parent.width;
                    height: parent.height;
                    page: step;
                    current-page: root.page;
                    show-steps: root.show-steps;
                    busy: root.busy;
                    can-retry: root.can-retry;
                    retry-storage: root.retry-storage;
                    status: root.status;
                    error: root.error;
                    security-acknowledged <=> root.security-acknowledged;
                    terms-acknowledged <=> root.terms-acknowledged;
                    gutter: root.gutter;
                    reading-width: root.reading-width;
                    heading-size: root.width < 960px ? 32px : 38px;
                    top-padding: root.height < 600px ? 40px : 64px;
                }
            }

            if root.page > 0 && (root.show-steps || root.can-retry || root.manage-account): Rectangle {
                height: 84px;
                background: Theme.sidebar;

                Rectangle { y: 0; height: 1px; background: Theme.divider; }

                if root.show-steps: HorizontalLayout {
                    alignment: center;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 8px;

                    for step[index] in ["Welcome", "How VOID works", "Security notice", "Terms of service", "Create account"]: HorizontalLayout {
                        spacing: 8px;
                        if index > 0: Rectangle {
                            width: 14px;
                            height: 1px;
                            y: (parent.height - self.height) / 2;
                            background: index < root.page ? Theme.accent : Theme.divider;
                        }
                        SetupStep {
                            y: (parent.height - self.height) / 2;
                            label: step;
                            number: index + 1;
                            current-page: root.page;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    padding-top: 20px;
                    padding-bottom: 20px;
                    spacing: 12px;

                    if root.page > 1 && root.page <= 5 && (root.page < 5 || (root.error == "" && !root.retry-storage)): Action {
                        label: "Back";
                        enabled: !root.busy;
                        clicked => { root.page -= 1; }
                    }
                    if root.manage-account: Action {
                        label: "Remove from this device";
                        clicked => { root.remove-local(); }
                    }
                    if root.manage-account: Action {
                        label: "Delete account permanently";
                        clicked => { root.delete-permanently(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.page < 5: Action {
                        label: root.page == 1 ? "Get started" : "Continue";
                        primary: true;
                        enabled: (root.page != 3 || root.security-acknowledged)
                            && (root.page != 4 || root.terms-acknowledged);
                        clicked => { root.page += 1; }
                    }
                    if root.page >= 5 && root.can-retry: Action {
                        label: root.action;
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.submit(); }
                    }
                }
            }
        }
    }
}
export component AppWindow inherits Window {
    title: root.setup-page == 0 ? "VOID" : "VOID — Account setup";
    preferred-width: 1080px;
    preferred-height: 680px;
    min-width: 850px;
    min-height: 560px;
    background: Theme.background;
    in property <string> account-void-id;
    in-out property <int> setup-page: -1;
    in property <bool> setup-busy: true;
    in property <bool> setup-can-retry: true;
    in property <bool> setup-retry-storage;
    in property <string> setup-status: "Opening protected local storage…";
    in property <string> setup-error;
    in property <string> setup-action: "Create account";
    callback submit-setup();
    callback account-registered();
    in property <string> connection-status: "Disconnected";
    out property <bool> can-reconnect: root.storage-ready
        && (root.connection-status == "Disconnected" || root.connection-status == "Reconnecting"
            || root.connection-status == "Authentication failed");
    callback reconnect();
    in property <bool> messaging-ready;
    in property <bool> publishing-keys;
    in property <string> publication-error;
    in property <bool> publication-retryable;
    in property <bool> send-busy;
    in property <string> messaging-notice;
    callback storage-opened();
    callback retry-messaging();
    callback send-message();
    callback resend-message(string);
    callback draft-queued(string, string, int);

    in-out property <string> section: "Chats";

    in property <bool> storage-ready;
    in property <bool> storage-loading: true;
    in property <bool> storage-retryable;
    in property <string> storage-error;
    in property <[StoredConversation]> stored-chats;
    in property <[StoredConversation]> stored-requests;
    in property <[StoredContact]> stored-contacts;
    in property <[StoredMessage]> stored-messages;
    in property <string> selected-conversation;
    in property <string> conversation-title;
    in property <bool> conversation-is-request;
    in property <bool> conversation-peer-deleted;
    in-out property <bool> conversation-loading;
    in-out property <bool> creating-conversation;
    in-out property <string> conversation-error;
    in-out property <string> stored-draft;
    in property <string> draft-status;
    in property <bool> draft-save-failed;
    in property <bool> unsaved-draft-failure;
    in-out property <int> storage-selection-token;
    in property <int> storage-draft-token;
    callback retry-storage();
    callback select-stored-conversation(string);
    callback create-stored-conversation(string);
    callback save-stored-draft(string);
    callback load-stored-draft(string, string);
    callback report-draft-saved(string, int, bool);

    in-out property <string> permanent-deletion-phrase;
    out property <bool> permanent-deletion-open: false;
    out property <bool> permanent-deletion-confirmed:
        root.permanent-deletion-open && root.permanent-deletion-phrase == "DELETE";
    private property <bool> permanent-deletion-supported: false;
    out property <bool> can-permanently-delete:
        root.permanent-deletion-supported && root.permanent-deletion-confirmed;
    callback open-permanent-deletion();
    callback cancel-permanent-deletion();
    in-out property <string> local-removal-phrase;
    out property <bool> local-removal-open: false;
    out property <bool> local-removal-confirmed:
        root.local-removal-open && root.local-removal-phrase == "DELETE";
    in property <bool> local-removal-busy;
    in property <string> local-removal-error;
    in property <bool> local-removal-can-go-back;
    callback open-local-removal();
    callback cancel-local-removal();
    callback request-local-removal();
    callback leave-failed-removal();

    open-permanent-deletion => {
        if root.account-void-id != "" {
            root.cancel-local-removal();
            root.permanent-deletion-phrase = "";
            root.permanent-deletion-open = true;
        }
    }
    cancel-permanent-deletion => {
        root.permanent-deletion-open = false;
        root.permanent-deletion-phrase = "";
    }
    open-local-removal => {
        if root.account-void-id != "" {
            root.cancel-permanent-deletion();
            root.local-removal-phrase = "";
            root.local-removal-open = true;
        }
    }
    cancel-local-removal => {
        root.local-removal-open = false;
        root.local-removal-phrase = "";
    }

    private property <[StoredConversation]> visible-conversations: root.section == "Requests"
        ? root.stored-requests : root.stored-chats;
    private property <bool> show-conversation: root.selected-conversation != "" && !root.creating-conversation
        && ((root.section == "Requests" && root.conversation-is-request)
            || (root.section == "Chats" && !root.conversation-is-request));
    out property <bool> conversation-can-compose: root.show-conversation && !root.conversation-peer-deleted;
    out property <string> conversation-account-notice: root.show-conversation && root.conversation-peer-deleted
        ? "This user account has been deleted." : "";

    changed section => { root.cancel-permanent-deletion(); root.cancel-local-removal(); }
    changed settings-section => { root.cancel-permanent-deletion(); root.cancel-local-removal(); }

    function navigate(section: string) {
        if root.section != section {
            root.section = section;
            root.creating-conversation = false;
            root.conversation-error = "";
            root.storage-selection-token += 1;
            root.conversation-loading = false;
        }
    }

    private property <bool> compact: self.width < 1000px;
    private property <string> settings-section: "Appearance";
    private property <length> collapsed-rail-width: 64px;
    private property <length> list-start: root.collapsed-rail-width + 1px;
    private property <length> requested-list-width: 280px;
    private property <length> divider-width: 9px;
    private property <length> min-list-width: 220px;
    private property <length> max-list-width: min(480px, root.width - root.list-start - root.divider-width - 330px);
    private property <length> header-height: 72px;
    private property <length> list-gutter: 16px;
    private property <length> chat-gutter: root.compact ? 20px : 28px;
    private property <bool> enrolling: root.setup-page == 6;
    out property <bool> can-manage-enrollment-account: root.enrolling && root.account-void-id != "";
    private property <bool> showing-account-removal: root.permanent-deletion-open || root.local-removal-open
        || root.local-removal-busy || root.local-removal-error != "";
    out property <bool> enrollment-can-retry: root.enrolling && !root.storage-loading
        && ((root.storage-error != "" && root.storage-retryable)
            || root.connection-status == "Authentication failed"
            || (root.connection-status == "Connected" && root.publication-retryable));
    private property <bool> enrollment-busy: root.storage-loading || root.publishing-keys
        || root.connection-status == "Connecting" || root.connection-status == "Reconnecting";
    private property <string> enrollment-status: root.storage-loading ? root.setup-status
        : root.publishing-keys ? "Publishing encryption keys…"
        : root.connection-status == "Reconnecting" ? "Waiting for the relay to reconnect…"
        : "Connecting to the relay…";
    private property <string> enrollment-error: root.storage-error != "" ? root.storage-error
        : root.connection-status == "Authentication failed" ? "VOID could not authenticate with the relay. Retry to continue enrollment."
        : root.publication-error;

    if root.showing-account-removal: AccountRemovalPage {
        permanent: root.permanent-deletion-open;
        busy: root.local-removal-busy;
        error: root.local-removal-error;
        can-go-back: root.local-removal-can-go-back;
        phrase: self.permanent ? root.permanent-deletion-phrase : root.local-removal-phrase;
        can-confirm: self.permanent ? root.can-permanently-delete : root.local-removal-confirmed;
        edit-phrase(text) => {
            if self.permanent { root.permanent-deletion-phrase = text; }
            else { root.local-removal-phrase = text; }
        }
        cancel => {
            if root.local-removal-error != "" {
                root.leave-failed-removal();
            } else {
                root.cancel-local-removal();
                root.cancel-permanent-deletion();
            }
        }
        confirm => { if !self.permanent { root.request-local-removal(); } }
    }

    if root.setup-page != 0 && !root.showing-account-removal: AccountSetup {
        page <=> root.setup-page;
        busy: root.enrolling ? root.enrollment-busy : root.setup-busy;
        can-retry: root.enrolling ? root.enrollment-can-retry : root.setup-can-retry;
        retry-storage: root.setup-retry-storage;
        status: root.enrolling ? root.enrollment-status : root.setup-status;
        error: root.enrolling ? root.enrollment-error : root.setup-error;
        action: root.enrolling ? "Retry" : root.setup-action;
        manage-account: root.can-manage-enrollment-account;
        remove-local => { root.open-local-removal(); }
        delete-permanently => { root.open-permanent-deletion(); }
        submit => {
            if !root.enrolling {
                root.submit-setup();
            } else if root.enrollment-can-retry {
                if root.storage-error != "" {
                    root.retry-storage();
                } else if root.connection-status == "Authentication failed" {
                    root.reconnect();
                } else {
                    root.retry-messaging();
                }
            }
        }
    }

    if root.setup-page == 0 && !root.showing-account-removal: Rectangle {
        sidebar := Rectangle {
            private property <bool> section-hovered: main-navigation.has-hover || settings-navigation.has-hover;
            private property <length> expanded-width: 168px;
            private property <float> reveal-progress: clamp(
                (self.width - root.collapsed-rail-width) / (self.expanded-width - root.collapsed-rail-width), 0, 1);
            private property <float> label-opacity: self.reveal-progress * self.reveal-progress *
                (3 - 2 * self.reveal-progress);
            x: 0;
            width: self.section-hovered ? self.expanded-width : root.collapsed-rail-width;
            z: 1;
            background: Theme.sidebar;
            clip: true;
            animate width {
                duration: sidebar.section-hovered ? 180ms : 150ms;
                easing: ease-in-out;
            }

            // Keep clicks on the overlay from reaching the covered pane.
            TouchArea {}

            VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    Rectangle {
                        x: 14px;
                        y: (parent.height - self.height) / 2;
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: Theme.accent;
                        Text {
                            text: "V";
                            color: Theme.sidebar;
                            font-size: 21px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    Text {
                        x: 62px;
                        width: self.preferred-width;
                        opacity: sidebar.label-opacity;
                        text: "VOID";
                        color: Theme.primary;
                        font-size: 20px;
                        font-weight: 800;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: Theme.divider; }

                main-navigation := TouchArea {
                    height: main-buttons.min-height;

                    main-buttons := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        NavItem {
                            label: "Chats";
                            icon: NavIcon.chats;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Chats";
                            clicked => { root.navigate("Chats"); }
                        }
                        NavItem {
                            label: "Requests";
                            icon: NavIcon.requests;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Requests";
                            clicked => { root.navigate("Requests"); }
                        }
                        NavItem {
                            label: "Contacts";
                            icon: NavIcon.contacts;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Contacts";
                            clicked => { root.navigate("Contacts"); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                settings-navigation := TouchArea {
                    height: settings-buttons.min-height;

                    settings-buttons := VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        Rectangle { height: 1px; background: Theme.divider; }
                        NavItem {
                            label: "Settings";
                            icon: NavIcon.settings;
                            label-opacity: sidebar.label-opacity;
                            selected: root.section == "Settings";
                            clicked => { root.navigate("Settings"); }
                        }
                    }
                }
            }
        }

        Rectangle { x: sidebar.width; z: 1; width: 1px; background: Theme.divider; }

        list-pane := Rectangle {
            x: root.list-start;
            width: clamp(root.requested-list-width, root.min-list-width, root.max-list-width);
            background: Theme.surface;

            VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    HorizontalLayout {
                        padding-left: root.list-gutter;
                        padding-right: root.list-gutter;
                        padding-top: (root.header-height - 44px) / 2;
                        padding-bottom: self.padding-top;
                        spacing: 8px;

                        Text {
                            text: root.section;
                            color: Theme.primary;
                            font-size: 22px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.storage-ready && root.section == "Chats": Action {
                            label: "+ New";
                            primary: true;
                            enabled: !root.conversation-loading;
                            clicked => {
                                root.conversation-error = "";
                                root.creating-conversation = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.divider; }

                if root.section != "Settings" && !root.storage-ready: VerticalLayout {
                    padding: root.list-gutter;
                    spacing: 12px;

                    Text {
                        text: root.storage-loading ? "Opening encrypted storage…" : root.storage-error;
                        color: root.storage-loading ? Theme.secondary : Theme.error;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if !root.storage-loading: Action {
                        label: "Try again";
                        clicked => { root.retry-storage(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.section != "Settings" && root.storage-ready: ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;

                    VerticalLayout {
                        padding: root.list-gutter;
                        spacing: 4px;

                        if root.section == "Contacts" ? root.stored-contacts.length == 0 : root.visible-conversations.length == 0: Text {
                            text: root.section == "Requests" ? "No incoming requests"
                                : root.section == "Contacts" ? "No contacts yet"
                                : "No conversations yet";
                            color: Theme.secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.section == "Contacts": VerticalLayout {
                            spacing: 4px;
                            for contact in root.stored-contacts: StorageRow {
                                label: contact.title;
                                detail: "VOID-ID " + contact.void-id;
                                enabled: !root.conversation-loading;
                                clicked => { root.create-stored-conversation(contact.void-id); }
                            }
                        }
                        if root.section != "Contacts": VerticalLayout {
                            spacing: 4px;
                            for chat in root.visible-conversations: StorageRow {
                                label: chat.title;
                                detail: chat.activity;
                                selected: root.show-conversation && root.selected-conversation == chat.id;
                                enabled: !root.conversation-loading;
                                clicked => {
                                    root.creating-conversation = false;
                                    root.select-stored-conversation(chat.id);
                                }
                            }
                        }
                    }
                }

                if root.section == "Settings": VerticalLayout {
                    padding: root.list-gutter;
                    spacing: 8px;
                    for category in ["Appearance", "Account", "About"]: Action {
                        label: category;
                        selected: root.settings-section == category;
                        clicked => { root.settings-section = category; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.unsaved-draft-failure: VerticalLayout {
                    padding-left: root.list-gutter;
                    padding-right: root.list-gutter;
                    padding-bottom: 8px;
                    Text {
                        text: "A draft could not be saved. Reopen its conversation to retry.";
                        color: Theme.error;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                if root.messaging-notice != "": VerticalLayout {
                    padding-left: root.list-gutter;
                    padding-right: root.list-gutter;
                    padding-bottom: 8px;
                    Text { text: root.messaging-notice; color: Theme.error; font-size: 12px; wrap: word-wrap; }
                }
                if root.publication-error != "" || root.connection-status == "Connected": VerticalLayout {
                    padding-left: root.list-gutter;
                    padding-right: root.list-gutter;
                    padding-bottom: 8px;
                    spacing: 6px;
                    Text {
                        text: root.publication-error != "" ? root.publication-error
                            : root.messaging-ready ? "Messaging ready" : "Preparing messaging…";
                        color: root.publication-error != "" ? Theme.error : Theme.secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.publication-retryable && root.connection-status == "Connected": Action {
                        label: "Retry messaging";
                        clicked => { root.retry-messaging(); }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                HorizontalLayout {
                    height: 56px;
                    padding-left: root.list-gutter;
                    padding-right: root.list-gutter;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: root.connection-status == "Connected" ? "Relay authenticated" : root.connection-status;
                        accessible-label: "Relay connection: " + self.text;
                        color: root.connection-status == "Authentication failed" ? Theme.error
                            : root.connection-status == "Connected" ? Theme.accent : Theme.secondary;
                        font-size: 12px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.can-reconnect: Action {
                        label: "Reconnect";
                        enabled: !root.send-busy;
                        clicked => { root.reconnect(); }
                    }
                }
            }
        }

        divider := TouchArea {
            x: list-pane.x + list-pane.width;
            width: root.divider-width;
            mouse-cursor: col-resize;

            moved => {
                if self.pressed {
                    root.requested-list-width = clamp(list-pane.width + self.mouse-x - self.pressed-x,
                        root.min-list-width, root.max-list-width);
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                width: divider.pressed || divider.has-hover || resize-focus.has-focus ? 2px : 1px;
                background: divider.pressed || divider.has-hover || resize-focus.has-focus ? Theme.accent : Theme.divider;
            }

            resize-focus := FocusScope {
                width: 0;
                key-pressed(event) => {
                    if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        root.requested-list-width = clamp(list-pane.width + (event.text == Key.LeftArrow ? -16px : 16px),
                            root.min-list-width, root.max-list-width);
                        return accept;
                    }
                    return reject;
                }
            }
        }

        chat-pane := Rectangle {
            x: divider.x + divider.width;
            width: parent.width - self.x;

            if root.section == "Settings": VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    background: Theme.surface;
                    Text {
                        x: root.chat-gutter;
                        text: root.settings-section;
                        color: Theme.primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout {
                        padding: root.chat-gutter;
                        spacing: 16px;
                        SettingDetail {
                            label: root.settings-section == "Appearance" ? "Theme"
                                : root.settings-section == "Account" ? "VOID-ID" : "VOID";
                            value: root.settings-section == "Appearance" ? "Dark"
                                : root.settings-section == "Account" ? root.account-void-id : "Native app";
                            description: root.settings-section == "Appearance" ? "Uses the VOID dark palette."
                                : root.settings-section == "Account" ? "Your account is stored on this device."
                                : "";
                        }
                        if root.settings-section == "Account" && root.account-void-id != "": HorizontalLayout {
                            spacing: 12px;
                            Action {
                                label: "Remove from this device";
                                clicked => { root.open-local-removal(); }
                            }
                            Action {
                                label: "Delete account permanently";
                                clicked => { root.open-permanent-deletion(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }

            if root.section != "Settings" && !root.creating-conversation && !root.show-conversation: VerticalLayout {
                padding: root.chat-gutter;
                alignment: center;

                Text {
                    text: root.conversation-error != "" ? root.conversation-error
                        : root.conversation-loading ? "Loading conversation…"
                        : !root.storage-ready ? ""
                        : root.section == "Chats" ? "Open a local conversation to view its history or write a draft."
                        : root.section == "Requests" ? "Open a saved request to view it here."
                        : "Open a saved contact to view their conversation.";
                    color: root.conversation-error != "" ? Theme.error : Theme.secondary;
                    font-size: 16px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }

            if root.creating-conversation && root.section == "Chats": VerticalLayout {
                padding: root.chat-gutter;
                spacing: 12px;

                Text { text: "New local conversation"; color: Theme.primary; font-size: 20px; font-weight: 700; }
                Text {
                    text: "Enter the recipient’s VOID-ID to open a conversation.";
                    color: Theme.secondary;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text { text: "Peer VOID-ID"; color: Theme.primary; font-size: 14px; }
                peer := LineEdit {
                    accessible-label: "Peer VOID-ID";
                    height: 44px;
                    enabled: !root.conversation-loading;
                    edited => { root.conversation-error = ""; }
                    accepted => { root.create-stored-conversation(self.text); }
                }
                if root.conversation-error != "": Text {
                    text: root.conversation-error;
                    color: Theme.error;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Action {
                        label: "Cancel";
                        enabled: !root.conversation-loading;
                        clicked => { root.creating-conversation = false; root.conversation-error = ""; }
                    }
                    Action {
                        label: root.conversation-loading ? "Opening…" : "Open conversation";
                        primary: true;
                        enabled: !root.conversation-loading && peer.text != "";
                        clicked => { root.create-stored-conversation(peer.text); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.show-conversation: VerticalLayout {
                Rectangle {
                    height: root.header-height;
                    background: Theme.surface;
                    VerticalLayout {
                        padding-left: root.chat-gutter;
                        padding-right: root.chat-gutter;
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: root.conversation-title;
                            color: Theme.primary;
                            font-size: 16px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text { text: "Local history"; color: Theme.secondary; font-size: 12px; }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                if root.conversation-loading || root.conversation-error != "": Text {
                    text: root.conversation-loading ? "Loading conversation…" : root.conversation-error;
                    color: root.conversation-loading ? Theme.secondary : Theme.error;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout {
                        padding: root.chat-gutter;
                        spacing: 8px;
                        if root.stored-messages.length == 0: Text {
                            text: "No saved messages";
                            color: Theme.secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                        for message in root.stored-messages: HorizontalLayout {
                            if message.outgoing: Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: min(380px, (chat-pane.width - 2 * root.chat-gutter) * 0.82,
                                    max(body.preferred-width, time.preferred-width, state.preferred-width,
                                        !root.conversation-peer-deleted && message.retry-event != "" ? 84px : 0px) + 20px);
                                min-height: bubble.min-height;
                                background: message.outgoing ? Theme.outgoing : Theme.elevated;
                                border-radius: 12px;
                                bubble := VerticalLayout {
                                    padding: 10px;
                                    spacing: 3px;
                                    body := Text { text: message.body; color: Theme.primary; font-size: 14px; wrap: word-wrap; }
                                    time := Text { text: message.time; color: Theme.secondary; font-size: 11px; horizontal-alignment: right; }
                                    state := Text {
                                        visible: message.status != "";
                                        text: message.status;
                                        color: Theme.secondary;
                                        font-size: 11px;
                                        horizontal-alignment: right;
                                        wrap: word-wrap;
                                    }
                                    if !root.conversation-peer-deleted && message.retry-event != "": HorizontalLayout {
                                        Rectangle { horizontal-stretch: 1; }
                                        Action {
                                            label: "Resend";
                                            enabled: root.messaging-ready && !root.send-busy;
                                            clicked => { root.resend-message(message.retry-event); }
                                        }
                                    }
                                }
                            }
                            if !message.outgoing: Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                if root.conversation-account-notice != "": VerticalLayout {
                    padding: root.chat-gutter;
                    spacing: 4px;
                    Text { text: root.conversation-account-notice; color: Theme.primary; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                    Text { text: "You can no longer send messages to this account."; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                }
                if root.conversation-can-compose: VerticalLayout {
                    padding: 12px;
                    padding-left: root.chat-gutter;
                    padding-right: root.chat-gutter;
                    spacing: 6px;
                    Text { text: "Message"; color: Theme.primary; font-size: 13px; font-weight: 600; }
                    TextEdit {
                        accessible-label: "Local message draft";
                        height: 72px;
                        enabled: !root.conversation-loading;
                        text <=> root.stored-draft;
                        edited(text) => { root.save-stored-draft(text); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.draft-status != "" ? root.draft-status : "Drafts stay on this device";
                            color: root.draft-save-failed ? Theme.error : Theme.secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.draft-save-failed: Action {
                            label: "Retry saving";
                            enabled: !root.conversation-loading;
                            clicked => { root.save-stored-draft(root.stored-draft); }
                        }
                        Action {
                            label: root.send-busy ? "Sending…" : "Send";
                            primary: true;
                            enabled: !root.send-busy && !root.conversation-loading && root.stored-draft != "";
                            clicked => { root.send-message(); }
                        }
                    }
                }
            }
        }
    }
}
